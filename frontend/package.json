{
  "name": "ace-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "HooH 的主前端（TypeScript + Ink）。与 Python 引擎通过 `ace --serve` 的 NDJSON 协议对话。",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "tsx src/index.tsx",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "preview": "tsx tools/preview.tsx"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "ink": "^5.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-reconciler": "^0.34.0",
    "usehooks-ts": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
